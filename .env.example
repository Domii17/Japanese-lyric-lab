# Optional AI explanations for a self-hosted deployment.
# Keep real keys server-side. Never prefix API keys with NEXT_PUBLIC_.
AI_FEATURE_ENABLED=true
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Set AI_PROVIDER=openai to use OpenAI instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: show a link to this repository on deployments without AI.
REPOSITORY_URL=
